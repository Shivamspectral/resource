# Copy to .env (or set these in your host's dashboard)
PORT=4000
# REQUIRED in production: long random string (e.g. `openssl rand -hex 48`)
JWT_SECRET=
# Your Vercel frontend URL(s), comma separated. Use * only for local testing.
CORS_ORIGIN=https://your-app.vercel.app
# Where db.json is stored. Must be a persistent disk in production.
DATA_DIR=./data
